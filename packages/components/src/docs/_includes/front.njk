<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">

        <link rel="stylesheet" type="text/css" href="/style.css">

        <script type="module" src="/_js/mi-components.esm.js"></script>
        <script nomodule src="/_js/mi-components.js"></script>
        <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/highlight.min.js"></script>
        <script>
            hljs.initHighlightingOnLoad();
        </script>
        <script>
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.write('<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/styles/dracula.min.css">');
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                document.write('<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/styles/github-gist.min.css">');
            }
        </script>

        <title>{{ title }}</title>

    </head>

    <body class="front">

        <header>
            <div class="wrap">
                <section class="flex">
                    <div class="left"></div>
                    <div class="right">
                        <a href="https://docs.mapsindoors.com">Docs</a>
                        <a href="https://mapspeople.com/support">Support</a>
                        <a href="https://github.com/mapspeople">GitHub</a>
                        <a href="https://blog.mapspeople.com/tag/product">Blog</a>
                        <a href="https://cms.mapsindoors.com">CMS</a>
                    </div>
                </section>
            </div>
        </header>

        <section class="container">
            <main class="wrap">
                <h1>MI-Components</h1>
                {%- for post in collections.components -%}
                    <div class="front-card">
                        <span>
                            <a href="{{ post.url }}">{{ post.data.title }}</a>
                        </span>
                    </div>

                {%- endfor -%}
            </main>
        </section>

        <script>
            const nav = document.getElementById("nav")
            nav.addEventListener('change', (e) => {
                console.log(e)
                nav
                    .selected
                    .forEach(item => {
                        window.location.href = item.value;
                    })
            });
        </script>
    </body>
</html>
