<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">

        <link rel="stylesheet" type="text/css" href="/style.css">

        <script type="module" src="/_js/mi-components.esm.js"></script>
        <script nomodule src="/_js/mi-components.js"></script>
        <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/highlight.min.js"></script>
        <script>
            hljs.initHighlightingOnLoad();
        </script>
        <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.18.1/styles/github-gist.min.css">
        <title>{{ title }}</title>

    </head>

    <body>

        <header>
            <div class="wrap">
                <section class="flex">
                    <div class="left"></div>
                    <div class="right">
                        <mi-dropdown id="nav" label="Components" filterable>
                            {%- for post in collections.components -%}
                                <mi-dropdown-item value="{{ post.url }}" text="{{ post.data.title }}"/>
                            {%- endfor -%}
                        </mi-dropdown>
                    </div>
                </section>
            </div>
        </header>

        <section class="container">
            <main class="wrap">

                {{ content | safe }}
            </main>
        </section>

        <script>
            const nav = document.getElementById("nav")
            nav.addEventListener('change', (e) => {
                console.log(e)
                nav
                    .selected
                    .forEach(item => {
                        window.location.href = item.value;
                    })
            });
        </script>
    </body>
</html>
